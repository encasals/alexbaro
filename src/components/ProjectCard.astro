---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  coverImage: ImageMetadata;
  priority?: boolean;
}

const { slug, title, coverImage, priority = false } = Astro.props;

// Responsive widths for srcset - covers various viewport sizes
// Desktop: ~900px (half of 1800px max), Tablet: ~700px, Mobile: ~540px
const widths = [540, 720, 900, 1080, 1440];
---

<a href={`/projects/${slug}`} class="project-cover hold-space">
  <div class="cover-content-container">
    <div class="cover-image-wrap">
      <div class="cover-image">
        <div class="cover">
          <Image 
            src={coverImage} 
            alt={title}
            class="cover__img"
            widths={widths}
            sizes="(max-width: 540px) 100vw, (max-width: 932px) 50vw, 45vw"
            format="webp"
            quality={80}
            loading={priority ? "eager" : "lazy"}
            decoding={priority ? "sync" : "async"}
            fetchpriority={priority ? "high" : "auto"}
          />
        </div>
        <div class="details-wrap">
          <div class="details">
            <div class="details-inner">
              <div class="title">{title}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .project-cover {
    display: block;
    position: relative;
    width: 49.75%;
    margin-right: 0.5%;
  }
  
  .project-cover:nth-child(2n) {
    margin-right: 0;
  }
  
  .project-cover:nth-child(2n + 1) {
    clear: left;
    margin-left: 0;
  }
  
  .cover-content-container {
    margin-top: 1%;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    overflow: hidden;
    position: relative;
  }
  
  .cover-image-wrap {
    overflow: hidden;
    position: relative;
  }
  
  .cover-image {
    position: relative;
    float: none;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    transform: translateZ(0);
  }
  
  /* Aspect ratio holder for 16:9 */
  .project-cover.hold-space .cover-image:before {
    content: '';
    display: block;
    width: 100%;
    padding-bottom: 56.25%;
  }
  
  .cover-image:after {
    content: '';
    display: block;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    background-color: #fff;
    opacity: 0;
    transition: background-color 0.2s ease, opacity 0.2s ease;
    border-radius: 0;
  }
  
  .project-cover:hover .cover-image:after {
    background-color: #012B55;
    opacity: 0.41;
  }
  
  .cover-image,
  .cover {
    border-radius: 0;
  }
  
  .cover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 100%;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    overflow: hidden;
  }
  
  .cover__img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    object-fit: cover;
  }
  
  .details-wrap {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 100%;
    height: 100%;
    padding-top: 5%;
    padding-bottom: 5%;
    opacity: 0;
    transition: opacity 0.15s ease;
    backface-visibility: hidden;
  }
  
  .project-cover:hover .details-wrap {
    opacity: 1;
  }
  
  .details {
    display: flex;
    align-items: center;
    height: 100%;
    width: 100%;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 0;
    position: relative;
  }
  
  .details-inner {
    width: 100%;
    padding: 0 5%;
    overflow: hidden;
  }
  
  .details-inner:after {
    clear: both;
    content: '';
    display: table;
  }
  
  .title {
    color: #222;
    font-family: 'Inter', sans-serif;
    font-size: 26px;
    line-height: 33px;
    text-align: center;
    width: 100%;
    float: none;
    margin: auto;
    padding: 0;
  }
  
  /* Tablet */
  @media (max-width: 932px) {
    .title {
      font-size: 19px;
      line-height: 24px;
    }
    
    .cover-content-container {
      margin-top: 2%;
      margin-bottom: 0;
    }
  }
  
  /* Mobile */
  @media (max-width: 540px) {
    .project-cover {
      width: 100%;
      margin-right: 0 !important;
    }
    
    .title {
      font-size: 16px;
      line-height: 20px;
    }
    
    .cover-content-container {
      margin-top: 2%;
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
