---
interface Props {
  slug: string;
  title: string;
  coverImage: string;
  priority?: boolean;
}

const { slug, title, coverImage, priority = false } = Astro.props;
---

<a href={`/projects/${slug}`} class="project-cover">
  <div class="cover-content-container">
    <div class="cover-image-wrap">
      <div class="cover-image">
        <div class="cover">
          <img 
            src={coverImage} 
            alt={title}
            class="cover__img"
            loading={priority ? "eager" : "lazy"}
            decoding={priority ? "sync" : "async"}
            fetchpriority={priority ? "high" : "auto"}
          />
        </div>
        <div class="details-wrap">
          <div class="details">
            <div class="details-inner">
              <div class="title">{title}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .project-cover {
    display: block;
    position: relative;
    width: 49.75%;
    margin-right: 0.5%;
  }
  
  .project-cover:nth-child(2n) {
    margin-right: 0;
  }
  
  .project-cover:nth-child(2n + 1) {
    clear: left;
    margin-left: 0;
  }
  
  .cover-content-container {
    margin-top: 1%;
    overflow: hidden;
    position: relative;
  }
  
  .cover-image-wrap {
    overflow: hidden;
    position: relative;
  }
  
  .cover-image {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
  }
  
  .cover-image:after {
    content: '';
    display: block;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    background-color: #fff;
    opacity: 0;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }
  
  .project-cover:hover .cover-image:after {
    background-color: #012B55;
    opacity: 0.41;
  }
  
  .cover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    overflow: hidden;
  }
  
  .cover__img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    object-fit: cover;
  }
  
  .details-wrap {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 100%;
    height: 100%;
    padding: 5% 5%;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  
  .project-cover:hover .details-wrap {
    opacity: 1;
  }
  
  .details {
    display: flex;
    align-items: center;
    height: 100%;
    width: 100%;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 0;
  }
  
  .details-inner {
    width: 100%;
    padding: 0 5%;
    overflow: hidden;
  }
  
  .title {
    color: #222;
    font-family: 'Inter', sans-serif;
    font-size: 26px;
    line-height: 33px;
    text-align: center;
    width: 100%;
  }
  
  /* Tablet */
  @media (max-width: 932px) {
    .title {
      font-size: 19px;
      line-height: 24px;
    }
    
    .cover-content-container {
      margin-top: 2%;
    }
  }
  
  /* Mobile */
  @media (max-width: 540px) {
    .project-cover {
      width: 100%;
      margin-right: 0 !important;
    }
    
    .title {
      font-size: 16px;
      line-height: 20px;
    }
    
    .cover-content-container {
      margin-top: 2%;
    }
  }
</style>
