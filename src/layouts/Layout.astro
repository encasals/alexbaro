---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string;
  preloadImage?: string;
}

const siteUrl = 'https://alexbaro.vercel.app';
const defaultDescription = "Alex Baro is a comedy director and filmmaker based in London, creating short films, promos, and branded content.";
const defaultImage = "/images/covers/01-falling-out.png";
const defaultKeywords = "comedy director, filmmaker, London, Alex Baro, short films, comedy, promo, branded content, video production";

const { 
  title, 
  description = defaultDescription,
  image = defaultImage,
  type = 'website',
  keywords = defaultKeywords,
  preloadImage
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Alex Baro" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Alex Baro" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alex Baro",
      "jobTitle": "Comedy Director & Filmmaker",
      "url": siteUrl,
      "image": `${siteUrl}/images/covers/01-falling-out.png`,
      "sameAs": [],
      "worksFor": {
        "@type": "Organization",
        "name": "Freelance"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "London",
        "addressCountry": "GB"
      },
      "description": defaultDescription,
      "knowsAbout": ["Comedy Direction", "Filmmaking", "Short Films", "Promotional Videos", "Branded Content"]
    })} />
    
    <!-- Self-hosted Inter font for better performance -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    
    <!-- Preload LCP image if specified -->
    {preloadImage && (
      <link 
        rel="preload" 
        as="image" 
        href={preloadImage}
        fetchpriority="high"
      />
    )}
    
    <style is:inline>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 300 600;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
  </head>
  <body>
    <div class="site-wrapper">
      <header class="site-header">
        <div class="logo-wrap">
          <div class="logo">
            <a href="/">Alex Baro</a>
          </div>
          <div class="masthead-text">
            <h1>Comedy Director</h1>
          </div>
        </div>
        <nav class="main-nav">
          <div class="nav-section">
            <a href="/" class="nav-link page-title">Selected Work</a>
            <a href="/about" class="nav-link page-title">About / Contact</a>
          </div>
        </nav>
        <button class="hamburger" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </header>
      
      <main>
        <slot />
      </main>
      
      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} Alex Baro. All rights reserved.</p>
      </footer>
    </div>
    
    <!-- Mobile navigation overlay -->
    <div class="responsive-nav">
      <button class="close-responsive-click-area" aria-label="Close menu">
        <div class="close-responsive-button"></div>
      </button>
      <nav>
        <div class="nav-container">
          <a href="/" class="nav-link page-title">Selected Work</a>
          <a href="/about" class="nav-link page-title">About / Contact</a>
        </div>
      </nav>
    </div>
    
    <script>
      // Mobile menu toggle
      const hamburger = document.querySelector('.hamburger');
      const responsiveNav = document.querySelector('.responsive-nav');
      const closeBtn = document.querySelector('.close-responsive-click-area');
      const body = document.body;
      
      hamburger?.addEventListener('click', () => {
        responsiveNav?.classList.add('show');
        body.classList.add('show-responsive-nav');
      });
      
      closeBtn?.addEventListener('click', () => {
        responsiveNav?.classList.remove('show');
        body.classList.remove('show-responsive-nav');
      });
      
      // Close on nav link click
      responsiveNav?.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
          responsiveNav?.classList.remove('show');
          body.classList.remove('show-responsive-nav');
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #000000;
    --color-text: #ffffff;
    --color-text-secondary: #999999;
    --color-text-muted: #666666;
    --color-border: #333333;
    --color-accent: #012B55;
    --max-width: 1800px;
    --header-height: 80px;
    --sidebar-width: 23.5%;
    --main-width: 76.5%;
  }
  
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  html {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text);
    background: var(--color-bg);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  
  body {
    min-height: 100vh;
  }
  
  a {
    color: inherit;
    text-decoration: none;
  }
  
  img {
    max-width: 100%;
    height: auto;
    display: block;
    vertical-align: top;
  }
  
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  
  p {
    margin: 0;
  }
  
  .site-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  .site-header {
    display: flex;
    padding: 30px 3.5%;
    max-width: var(--max-width);
    width: 100%;
  }
  
  .logo-wrap {
    width: var(--sidebar-width);
    padding-right: 20px;
  }
  
  .logo {
    font-size: 11px;
    line-height: 30px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  
  .logo a {
    color: var(--color-text);
  }
  
  .logo a:hover {
    color: var(--color-text);
  }
  
  .masthead-text h1 {
    color: var(--color-text);
    font-size: 30px;
    font-weight: 400;
    line-height: 36px;
    margin-top: 33px;
    text-align: left;
  }
  
  .main-nav {
    width: var(--main-width);
    padding-top: 52px;
    display: flex;
    flex-direction: column;
  }
  
  .nav-section {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  
  .nav-link.page-title {
    color: var(--color-text);
    font-size: 20px;
    line-height: 20px;
    transition: text-decoration 0.2s ease;
  }
  
  .nav-link.page-title:hover,
  .nav-link.page-title.active {
    text-decoration: underline;
  }
  
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    position: absolute;
    right: 5%;
    top: 40px;
  }
  
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    transition: all 0.3s ease;
  }
  
  main {
    flex: 1;
    padding: 0 3.5%;
    max-width: var(--max-width);
    width: 100%;
  }
  
  .site-footer {
    padding: 60px 3.5%;
    color: #ddd;
    font-size: 16px;
    line-height: 18px;
  }
  
  /* Responsive Navigation Overlay */
  .responsive-nav {
    display: none;
    opacity: 0;
    visibility: hidden;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg);
    z-index: 99999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: visibility 0s ease 0.2s, opacity 0.2s ease 0s;
  }
  
  .responsive-nav.show {
    display: flex;
    opacity: 1;
    visibility: visible;
    transition: visibility 0s ease 0s, opacity 0.2s ease 0s;
  }
  
  .responsive-nav nav {
    text-align: center;
  }
  
  .responsive-nav .nav-container {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  
  .responsive-nav .nav-link {
    font-size: 22px;
    line-height: 32px;
  }
  
  .close-responsive-click-area {
    position: fixed;
    top: 0;
    right: 0;
    padding: 50px 6%;
    background: none;
    border: none;
    cursor: pointer;
  }
  
  .close-responsive-button {
    width: 20px;
    height: 20px;
    position: relative;
  }
  
  .close-responsive-button:before,
  .close-responsive-button:after {
    content: '';
    position: absolute;
    width: 2px;
    height: 20px;
    background-color: var(--color-text);
    left: 50%;
  }
  
  .close-responsive-button:before {
    transform: rotate(45deg);
  }
  
  .close-responsive-button:after {
    transform: rotate(-45deg);
  }
  
  /* Tablet and Mobile */
  @media (max-width: 932px) {
    .site-header {
      padding: 40px 5%;
      position: relative;
    }
    
    .logo-wrap {
      width: 100%;
      padding: 0;
    }
    
    .logo {
      padding-right: 39px;
    }
    
    .main-nav {
      display: none;
    }
    
    .hamburger {
      display: flex;
    }
    
    main {
      padding: 0;
    }
    
    .masthead-text h1 {
      font-size: 18px;
      line-height: 22px;
      margin-top: 19px;
    }
    
    .site-footer {
      padding: 28px 5%;
      font-size: 14px;
      line-height: 20px;
    }
  }
  
  @media (max-width: 540px) {
    .site-header {
      padding: 30px 5%;
    }
    
    .hamburger {
      top: 30px;
    }
    
    .masthead-text h1 {
      font-size: 16px;
      line-height: 19px;
      margin-top: 17px;
    }
    
    .close-responsive-click-area {
      padding: 40px 10%;
    }
    
    .site-footer {
      padding: 25px 5%;
    }
  }
</style>
