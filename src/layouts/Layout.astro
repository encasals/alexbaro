---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { defaultCoverImage } from '../data/projects';

interface Props {
  title: string;
  description?: string;
  ogImage?: ImageMetadata;
  type?: 'website' | 'article';
  keywords?: string;
  preloadImage?: ImageMetadata;
  showMasthead?: boolean;
  mastheadTitle?: string;
}

const siteUrl = 'https://alexbaro.com';
const defaultDescription = "Alex Baro is a comedy director and filmmaker based in London, creating short films, promos, and branded content.";
const defaultKeywords = "comedy director, filmmaker, London, Alex Baro, short films, comedy, promo, branded content, video production";

const { 
  title, 
  description = defaultDescription,
  ogImage,
  type = 'website',
  keywords = defaultKeywords,
  preloadImage,
  showMasthead = false,
  mastheadTitle = "Alex Baro-Cayetano | Writer-Director"
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Generate optimized OG image (social platforms prefer JPG, 1200x630 is ideal)
const ogImageSource = ogImage || defaultCoverImage;
const optimizedOgImage = await getImage({
  src: ogImageSource,
  format: 'jpg',
  quality: 85,
  width: 1200,
  height: 630,
  fit: 'cover'
});
const ogImageUrl = `${siteUrl}${optimizedOgImage.src}`;

// Generate optimized preload image for LCP
let preloadImageUrl: string | undefined;
if (preloadImage) {
  const optimizedPreload = await getImage({
    src: preloadImage,
    format: 'webp',
    quality: 80,
    width: 900
  });
  preloadImageUrl = optimizedPreload.src;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Alex Baro" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Alex Baro" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alex Baro",
      "jobTitle": "Comedy Director & Filmmaker",
      "url": siteUrl,
      "image": ogImageUrl,
      "sameAs": ["https://www.instagram.com/itsalexbaro/"],
      "worksFor": {
        "@type": "Organization",
        "name": "Freelance"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "London",
        "addressCountry": "GB"
      },
      "description": defaultDescription,
      "knowsAbout": ["Comedy Direction", "Filmmaking", "Short Films", "Promotional Videos", "Branded Content"]
    })} />
    
    <!-- Self-hosted Inter font for better performance -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    
    <!-- Preload LCP image if specified -->
    {preloadImageUrl && (
      <link 
        rel="preload" 
        as="image" 
        href={preloadImageUrl}
        type="image/webp"
        fetchpriority="high"
      />
    )}
    
    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- Additional page-specific head content -->
    <slot name="head" />
    
