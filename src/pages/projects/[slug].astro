---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { projects, getProjectBySlug } from '../../data/projects';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;

if (!project) {
  return Astro.redirect('/404');
}

// Generate optimized poster image for video element (needs URL string)
const posterImage = await getImage({ 
  src: project.coverImage, 
  format: 'webp',
  quality: 80,
  width: 1200 
});

const siteUrl = 'https://alexbaro.com';
const projectUrl = `${siteUrl}/projects/${project.slug}`;
const thumbnailUrl = `${siteUrl}${posterImage.src}`;

// Structured data for video content (VideoObject schema)
const videoSchema = project.videoFile ? {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": project.title,
  "description": project.description || `${project.title} - A project by Alex Baro`,
  "thumbnailUrl": thumbnailUrl,
  "uploadDate": `${project.year}-01-01`,
  "contentUrl": `${siteUrl}${project.videoFile}`,
  "creator": {
    "@type": "Person",
    "name": "Alex Baro",
    "jobTitle": "Comedy Director & Filmmaker",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Person",
    "name": "Alex Baro",
    "url": siteUrl
  }
} : null;

// CreativeWork schema for non-video projects
const creativeWorkSchema = !project.videoFile ? {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": project.title,
  "description": project.description || `${project.title} - A project by Alex Baro`,
  "image": thumbnailUrl,
  "dateCreated": `${project.year}-01-01`,
  "url": projectUrl,
  "creator": {
    "@type": "Person",
    "name": "Alex Baro",
    "jobTitle": "Comedy Director & Filmmaker",
    "url": siteUrl
  }
} : null;

// BreadcrumbList schema for navigation
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": project.title,
      "item": projectUrl
    }
  ]
};
---

<Layout 
  title={`${project.title} | Alex Baro`}
  description={project.description || `${project.title} - A project by Alex Baro`}
  ogImage={project.coverImage}
  type="article"
>
  <!-- Project-specific structured data -->
  {videoSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} slot="head" />
  )}
  {creativeWorkSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(creativeWorkSchema)} slot="head" />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  
  <article class="project-page">
    <header class="project-header">
      <a href="/" class="back-link">&larr; Back to Work</a>
      <h1 class="project-title">{project.title}</h1>
    </header>
    
    <div class="project-content">
      {project.videoFile && (
        <div class="video-container">
          <video 
            controls 
            preload="metadata"
            poster={posterImage.src}
            class="video-player"
          >
            <source src={project.videoFile} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      )}
      
      {project.youtubeId && (
        <div class="video-container">
          <VideoFacade 
            type="youtube" 
            videoId={project.youtubeId} 
            title={project.title}
          />
        </div>
      )}
      
      {project.vimeoId && (
        <div class="video-container">
          <VideoFacade 
            type="vimeo" 
            videoId={project.vimeoId} 
            title={project.title}
          />
        </div>
      )}
      
      {!project.videoFile && !project.youtubeId && !project.vimeoId && (
        <div class="no-video">
          <Image 
            src={project.coverImage} 
            alt={project.title} 
            class="cover-image"
            format="webp"
            quality={80}
            width={1200}
          />
          <p>Video coming soon.</p>
        </div>
      )}
    </div>
  </article>
</Layout>

<style>
  .project-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }
  
  .project-header {
    margin-bottom: 40px;
  }
  
  .back-link {
    display: inline-block;
    color: var(--color-text-secondary);
    font-size: 14px;
    margin-bottom: 20px;
    transition: color 0.2s ease;
  }
  
  .back-link:hover {
    color: var(--color-text);
  }
  
  .project-title {
    font-size: 36px;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 8px;
    color: var(--color-text);
  }
  
  .project-content {
    margin-top: 40px;
  }
  
  .video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    background: #111;
    border-radius: 4px;
    overflow: hidden;
  }
  
  .video-player,
  .video-embed,
  .video-facade {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .video-player {
    background: #000;
  }
  
  .no-video {
    text-align: center;
  }
  
  .no-video .cover-image {
    max-width: 100%;
    border-radius: 4px;
    margin-bottom: 20px;
  }
  
  .no-video p {
    color: var(--color-text-secondary);
    font-size: 16px;
  }
  
  @media (max-width: 768px) {
    .project-page {
      padding: 20px;
    }
    
    .project-title {
      font-size: 28px;
    }
    
    .project-description {
      font-size: 16px;
    }
  }
  
  @media (max-width: 540px) {
    .project-title {
      font-size: 24px;
    }
  }
</style>
